{
  "name": "agentopia",
  "private": true,
  "version": "0.1.0",
  "description": "Agentopia: a virtual company staffed by AI employees, with a living top-down office.",
  "packageManager": "pnpm@10.12.1",
  "engines": { "node": ">=20.19.0" },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"pnpm --filter @agentopia/web dev\" \"pnpm --filter @agentopia/worker dev\"",
    "dev:web": "pnpm --filter @agentopia/web dev",
    "dev:worker": "pnpm --filter @agentopia/worker dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @agentopia/web build && pnpm --filter @agentopia/worker build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @agentopia/web test:e2e",
    "db:generate": "pnpm --filter @agentopia/db generate",
    "db:migrate": "pnpm --filter @agentopia/db migrate",
    "db:deploy": "pnpm --filter @agentopia/db deploy",
    "db:seed": "pnpm --filter @agentopia/db seed",
    "db:reset": "pnpm --filter @agentopia/db reset",
    "runner": "pnpm --filter @agentopia/runner start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "tsx": "^4.20.6",
    "@types/node": "^22.18.0",
    "dotenv": "^17.2.3"
  }
}
