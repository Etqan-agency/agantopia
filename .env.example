# ---- Core ------------------------------------------------------------------
# PostgreSQL connection (local Homebrew example; docker-compose uses :5434)
DATABASE_URL="postgresql://khaledsakr@127.0.0.1:5432/agentopia?schema=public"
# Redis used by BullMQ (durable queues, schedulers) and SSE fan-out
REDIS_URL="redis://127.0.0.1:6380"
# Public URL of the web app (used by auth and the local runner)
APP_URL="http://localhost:3000"
# Set to "true" only when the app runs behind a reverse proxy you control (nginx, Vercel,
# Cloudflare). Rate limiting then keys unauthenticated requests on the first x-forwarded-for
# hop; otherwise that header is ignored because clients could forge it.
TRUSTED_PROXY="false"
# better-auth secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-me-with-32-random-bytes"
# AES-256-GCM key for provider credentials at rest: `openssl rand -base64 32`
AGENTOPIA_ENCRYPTION_KEY="replace-me-with-32-random-bytes-base64"
# Root folder for per-company isolated agent workspaces
AGENTOPIA_WORKSPACE_ROOT="./workspaces"
# Root folder for stored task artifacts
AGENTOPIA_ARTIFACT_ROOT="./artifacts"

# ---- Workers ---------------------------------------------------------------
# Max concurrent provider executions per worker process
EXECUTION_CONCURRENCY=2
# Max concurrent learning runs per worker process (always lower priority)
LEARNING_CONCURRENCY=1

# ---- Providers (NEVER commit real keys; these are read by the server only) --
# Provider keys are normally entered in the Integrations screen and stored
# encrypted in the database. These env fallbacks exist only for local testing
# of the adapters and are never exposed to the browser.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Demo / safety ---------------------------------------------------------
# When "true", the seeded demo company is created on `pnpm db:seed`
SEED_DEMO="true"
# Hard cap in USD per execution attempt if the owner has not set one
DEFAULT_MAX_COST_USD="1.00"
